# THE project config file: copy to backend/.env and fill in. Free tiers only.
# It is read by the backend AND by docker-compose (the Postgres container).

# --- Database (docker-compose exposes Postgres+pgvector on localhost:5433) ---
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_agent_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# Optional: full URLs instead (e.g. a hosted DB). Built from the values above if unset.
# DATABASE_URL_ASYNC=postgresql+asyncpg://user:pass@host:5432/db
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/db

# --- Auth (REQUIRED) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# --- API keys (both have free tiers) ---
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey

# --- Models ---
# Non-agent LLM calls (routing, summaries, memory, metadata, file generation).
# "gemini*" names go to Google AI Studio, everything else to Groq.
MODEL="openai/gpt-oss-20b"
# CHAT_MODEL=            # optional override for foreground calls
# MAINTENANCE_MODEL=     # optional override for background memory calls
LLM_FALLBACK_MODEL="gemini-3.5-flash-lite"
LLM_REASONING_EFFORT="low"   # gpt-oss only: low | medium | high
# ADK agents
AGENT_MODEL="gemini-3.1-flash-lite"
AGENT_FALLBACK_MODEL="gemini-3.5-flash-lite"
# Root agent (routing only)
ROUTER_MODEL="gemini-3.5-flash-lite"
ROUTER_FALLBACK_MODEL="gemini-3.1-flash-lite"

# --- Concurrency ---
LLM_MAX_WORKERS=4
MAINTENANCE_LLM_MAX_WORKERS=1
MAINTENANCE_MAX_COMPARISONS_PER_RUN=6

# --- File processing: "local" (thread pool) or "celery" (needs Redis) ---
FILE_PROCESSING_BACKEND="celery"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- Server ---
DB_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]

# --- Background LLM jobs (memory maintenance, per-message profile extraction) ---
# Set false for e2e / load-test runs: they don't need these jobs, and the jobs spend
# the free tier's daily token budget (Groq: 200k tokens/day per model).
BACKGROUND_LLM_JOBS_ENABLED=true
